# Copy this file to .env and fill in real values. docker-compose.yml already
# provides working defaults for local dev, so you usually don't need this
# file unless you're running the backend outside Docker or deploying it.

# --- Backend ---
PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=orders_db
DB_USER=orders_user
DB_PASSWORD=orders_pass

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Frontend (baked in at build time, see frontend/Dockerfile) ---
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
